{
  "Development": {
    "MockUserId": "22222222-2222-2222-2222-222222222222"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.AspNetCore.Hosting": "Information",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore.Query": "Debug",
        "Microsoft.EntityFrameworkCore.Infrastructure": "Warning",
        "System": "Information",
        "System.Net.Http.HttpClient": "Information",
        "Hangfire": "Information",
        "Application": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff}} {Level:u3}] {SourceContext:l} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341"
        }
      },
      {
        "Name": "Debug"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithThreadId",
      "WithExceptionDetails"
    ]
  },
  "ConnectionStrings" : {
    "FileServiceDb" : "Server=postgres;Port=5432;Database=file_service_db;User Id=postgres;Password=postgres;Search Path=public"
  },
  "AllowedHosts": "*",
  "S3Options": {
    "Endpoint": "http://minio:9000",
    "WithSsl": false,
    "DownloadUrlExpiration": "24:00:00",
    "UploadUrlExpiration": "06:00:00",
    "MaxConcurrentRequests": 20,
    "RequiredBuckets": ["videos", "preview", "documents"],
    "MinimumChunkSizeBytes": 5242880,
    "RecommendedChunkSizeBytes": 104857600,
    "MaxChunks": 10000
  },
  "CleanupServiceOptions": {
    "Enabled": true,
    "IntervalHours": 24,
    "RetentionDays": 30,
    "BatchSize": 100
  },
  "CacheOptions": {
    "RedisEndpoint": "redis:6379",
    "PresignedUrlTtl": "08:00:00",
    "LocalCacheTtl": "00:05:00"
  }
}
